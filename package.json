    "joi": "^18.3.1",
    "mime-types": "^3.0.2",
    "mongoose": "^9.12.2",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
